# Copy to backend/.env and fill in. Never commit .env.
# Empty values fall back to the defaults in app/core/config.py.

# development | test | production. Production refuses to start without
# NEBIUS_API_KEY, JWT_SECRET and FERNET_KEY.
APP_ENV=development

# --- Nebius Token Factory (OpenAI-compatible) ---
# Also used for Nebius Sandboxes, unless the Phase 0 spike shows they need their own key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirmed with GET /v1/models on 2026-10-11. IDs are case-sensitive.
NEMOTRON_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
NEMOTRON_SUPER=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# The only embedding model on Token Factory. Default size is 4096; 1024 fits the pgvector HNSW index.
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIMENSIONS=1024

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql+asyncpg://roottrace:roottrace@localhost:5432/roottrace
# SELECT-only role on the demo_app schema, used by the query_database tool.
READONLY_DATABASE_URL=

# --- Auth and secrets ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# CORS is locked to this origin.
FRONTEND_ORIGIN=http://localhost:5173

# --- Agent ---
# direct | mcp
TOOL_TRANSPORT=direct
# nebius | docker (docker is for offline development only)
SANDBOX_RUNNER=nebius

# --- GitHub and MCP ---
# Fine-grained token for the demo repo only (Contents + Pull requests: read and write).
# Used only after an engineer approves a fix, to open a draft PR.
GITHUB_TOKEN=
# Bearer token MCP clients must send to /mcp/*. Empty: the MCP servers refuse every call.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=
