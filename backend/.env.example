# Copy to backend/.env and fill in. Never commit .env.
# Empty values fall back to the defaults in app/core/config.py.

# development | test | production. Production refuses to start without
# NEBIUS_API_KEY, JWT_SECRET and FERNET_KEY.
APP_ENV=development

# --- Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
# Nebius Sandboxes run through the ConTree CLI, which reads NEBIUS_API_KEY and
# NEBIUS_AI_PROJECT from the real process environment, not from this file. Locally, log in once
# with `contree auth`. On a server, pass this file as the container environment (Compose
# `env_file:`), so the CLI sees both.
NEBIUS_AI_PROJECT=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Confirmed with GET /v1/models on 2026-10-11. IDs are case-sensitive.
NEMOTRON_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
NEMOTRON_SUPER=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# The only embedding model on Token Factory. Default size is 4096; 1024 fits the pgvector HNSW index.
EMBED_MODEL=Qwen/Qwen3-Embedding-8B
EMBED_DIMENSIONS=1024

# --- PostgreSQL + pgvector ---
DATABASE_URL=postgresql+asyncpg://roottrace:roottrace@localhost:5432/roottrace
# SELECT-only role on the demo_app schema, used by the query_database tool.
READONLY_DATABASE_URL=

# --- Auth and secrets ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# CORS is locked to this origin.
FRONTEND_ORIGIN=http://localhost:5173

# Clones of connected repositories go in DATA_DIR/repos (relative to backend/).
DATA_DIR=data

# --- Agent ---
# direct | mcp
TOOL_TRANSPORT=direct
# nebius | docker (docker is for offline development only)
SANDBOX_RUNNER=nebius

# --- GitHub and MCP ---
# Fine-grained token for the demo repo only (Contents + Pull requests: read and write).
# Used only after an engineer approves a fix, to open a draft PR.
GITHUB_TOKEN=
# Bearer token MCP clients must send to /mcp/*. Empty: the MCP servers refuse every call.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# --- Public demo guard rails ---
INVESTIGATION_COST_CAP_USD=0.50
DAILY_BUDGET_USD=5.00
INVESTIGATIONS_PER_HOUR=3
CHAT_MESSAGES_PER_HOUR=30
# Password of the demo user (demo@roottrace.dev) set by scripts/seed_demo.py.
DEMO_PASSWORD=
