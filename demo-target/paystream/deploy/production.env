# Production environment for PayStream. Secret values are injected from the vault at deploy time.
PAYSTREAM_DATABASE_URL=postgresql://paystream@db.internal:5432/paystream
PAYSTREAM_GATEWAY_API_KEY=vault:paystream/gateway-api-key
PAYSTREAM_WEBHOOK_SECRET=vault:paystream/webhook-secret
PAYSTREAM_INSTANCES=5
PAYSTREAM_DB_MAX_CONNECTIONS=100
